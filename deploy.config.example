# Per-environment /deploy config — see infrastructure/scripts/deploy-common.sh's
# header comment for the full schema. Gitignored (WEBAPP_PROJECT_STANDARD.md §9);
# copy this to deploy.config and edit if a value ever needs to differ locally.
#
# APP_NAME and PROFILE come from homelab.yml (§1a) — "holiday-house-comparison" / B —
# and don't need to be set here; setting them here anyway would be a smell to
# clean up, not a normal override, per WEBAPP_PROJECT_STANDARD.md §1a.
#
# Used by the shared /deploy for the homelab (local) target. The public FTP target
# is published by this repo's own deploy.sh/deploy.ps1 instead (README "Deployment").
# On a machine without /etc/homelab/holiday-house-comparison.env, those scripts read
# their FTP_*/SITE_PASSWORD keys from this same deploy.config file (deploy.config.template)
# -- the two key sets don't overlap, so both can live here.

# The repo's .venv, not a bare python/pytest: the deploy host's system Python
# has none of the requirements installed.
TEST_CMD=".venv/bin/python -m pytest -q"
BUILD_CMD=".venv/bin/python app.py"
BUILD_DIR="public"

# Homelab only. "public" would rsync over ssh, which the FTP-only host can't take.
TARGETS="local"
