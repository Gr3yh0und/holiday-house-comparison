# Copied to /etc/homelab/holiday-house-comparison.env once this runs on the Linux
# server (WEBAPP_PROJECT_STANDARD.md §4) -- never committed, and outside this
# Samba-shared working tree specifically so server-backup-sync.sh's wholesale
# /samba/ rsync can't copy these values offsite in cleartext.
#
# Ownership: gr3yh0und:gr3yh0und, mode 0600 -- NOT root:root. §4's root:root
# wording assumes a root-mediated reader (Docker's env_file:, read by the
# root-run daemon regardless of the invoking user's permissions); there's no
# such mediator for a Profile B script like deploy.sh, which runs as the same
# unprivileged user as this Claude session. A root:root 0600 file inside a
# root:root-only directory can't be read by that process at all. /etc/homelab/
# itself stays root:root but mode 0711 (traversable, not listable, by
# non-root), so this file's own 0600 is still the only thing gating read
# access to its contents.
#
# Until deploys move off whatever machine currently holds the real FTP
# credentials, deploy.sh/deploy.ps1 fall back to a repo-local deploy.config
# with the same keys (see deploy.config.template) -- that fallback is legacy,
# not the target state.

FTP_HOST=ftp.example.com
FTP_USER=username
FTP_PASS=password
FTP_REMOTE_PATH=/example.com

# Required. Passphrase for the site's PHP login gate (see deploy_auth/).
# deploy.sh/deploy.ps1 never upload this plaintext -- it's salted + hashed
# locally into deploy_auth/auth_secret.php (generated, gitignored) before that
# file is deployed. Change this value any time to invalidate every saved
# login in one shot. Deliberately NOT shared with housebuycomparison's
# SITE_PASSWORD (confirmed with the owner 2026-08-27).
SITE_PASSWORD=change-me
